type vendor_hal_neuralnetworks_qti, domain;
type vendor_hal_neuralnetworks_qti_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(vendor_hal_neuralnetworks_qti)
hal_server_domain(vendor_hal_neuralnetworks_qti, hal_neuralnetworks)
hwbinder_use(vendor_hal_neuralnetworks_qti)
add_hwservice(vendor_hal_neuralnetworks_qti, hal_neuralnetworks_hwservice)
allow vendor_hal_neuralnetworks_qti ion_device:chr_file r_file_perms;
